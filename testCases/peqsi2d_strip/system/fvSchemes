FoamFile { format ascii; class dictionary; object fvSchemes; }
ddtSchemes { default Euler; }
gradSchemes { default Gauss linear; }
divSchemes
{
    default none;
    div(phiv,rho)  Gauss WENOUpwindFit 3 1;
    div(phiv,rhoU) Gauss WENOUpwindFit 3 1;
    div(phiv,p)    Gauss WENOUpwindFit 3 1;
    div(phiv,rhoh) Gauss WENOUpwindFit 3 1;
    div(phiv)      Gauss linear;
    "div\(\(PEQSI:mu\*.*" Gauss linear;
    "div\(PEQSI:.*"        Gauss linear;
}
laplacianSchemes { default Gauss linear corrected; }
interpolationSchemes { default linear; }
snGradSchemes { default corrected; }

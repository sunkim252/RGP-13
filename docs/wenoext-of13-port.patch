+void Foam::reconstructRegionalMesh::matchCoupledBoundaryFaces
+(
+    const fvMesh& masterMesh,
+    const fvMesh& meshToAdd,
+    const scalar mergeDist,
+    labelList& masterAddr,
+    labelList& slaveAddr
+)
+{
+    const label nMasterBnd = masterMesh.nFaces() - masterMesh.nInternalFaces();
+    const label nSlaveBnd  = meshToAdd.nFaces() - meshToAdd.nInternalFaces();
+
+    // Boundary-face centres of both meshes in one list:
+    // [0, nMasterBnd) master, [nMasterBnd, nMasterBnd+nSlaveBnd) slave
+    pointField centres(nMasterBnd + nSlaveBnd);
+
+    for (label i = 0; i < nMasterBnd; i++)
+    {
+        centres[i] =
+            masterMesh.faces()[masterMesh.nInternalFaces() + i]
+           .centre(masterMesh.points());
+    }
+    for (label i = 0; i < nSlaveBnd; i++)
+    {
+        centres[nMasterBnd + i] =
+            meshToAdd.faces()[meshToAdd.nInternalFaces() + i]
+           .centre(meshToAdd.points());
+    }
+
+    labelList pointMap;
+    const label nUnique = mergePoints(centres, mergeDist, false, pointMap);
+
+    // A merged index shared by one master and one slave face = a couple
+    labelList mergedToMaster(nUnique, -1);
+    labelList mergedToSlave(nUnique, -1);
+    label nCouples = 0;
+
+    for (label i = 0; i < nMasterBnd; i++)
+    {
+        mergedToMaster[pointMap[i]] = i;
+    }
+    for (label i = 0; i < nSlaveBnd; i++)
+    {
+        const label m = pointMap[nMasterBnd + i];
+
+        if (mergedToSlave[m] != -1)
+        {
+            FatalErrorInFunction
+                << "Two boundary faces of the added processor mesh share "
+                << "one face-centre location -- merge tolerance "
+                << mergeDist << " too large for this mesh"
+                << exit(FatalError);
+        }
+        mergedToSlave[m] = i;
+
+        if (mergedToMaster[m] != -1)
+        {
+            nCouples++;
+        }
+    }
+
+    masterAddr.setSize(nCouples);
+    slaveAddr.setSize(nCouples);
+
+    label coupleI = 0;
+    for (label m = 0; m < nUnique; m++)
+    {
+        if (mergedToMaster[m] != -1 && mergedToSlave[m] != -1)
+        {
+            masterAddr[coupleI] =
+                masterMesh.nInternalFaces() + mergedToMaster[m];
+            slaveAddr[coupleI] =
+                meshToAdd.nInternalFaces() + mergedToSlave[m];
+            coupleI++;
+        }
+    }
+}

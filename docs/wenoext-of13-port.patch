+void Foam::WENOBase::buildBpack()
+{
+    // Upper-triangle packing of the symmetric smoothness matrices.
+    const label nTri = nDvt_*(nDvt_ + 1)/2;
+    Bpack_.setSize(B_.size()*nTri, 0.0f);
+
+    forAll(B_, celli)
+    {
+        const auto& Bc = B_[celli];
+        float* dst = Bpack_.data() + celli*nTri;
+        label idx = 0;
+        for (label i = 0; i < nDvt_; i++)
+        {
+            for (label j = i; j < nDvt_; j++)
+            {
+                dst[idx++] =
+                    (
+                        label(Bc.rows()) > i && label(Bc.columns()) > j
+                      ? float(Bc(i, j))
+                      : 0.0f
+                    );
+            }
+        }
+    }
+}

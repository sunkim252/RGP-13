+void Foam::WENOBase::distribute(const polyDistributionMap&)
+{
+    // Every cached quantity is indexed by local cell or face number, and
+    // redistribution renumbers both.  The map argument is deliberately
+    // unused: remapping the stencils would still leave every halo, every
+    // pseudo inverse and the on-disk bank to be rebuilt, so we discard and
+    // re-derive.  The bank directory name carries mesh.nCells(), so the
+    // rebuild lands on a fresh entry instead of reading the old one back.
+    Info<< "WENOBase: mesh redistributed -- rebuilding the WENO base" << endl;
+
+    clearState();
+    build(mesh(), polOrder_);
+}

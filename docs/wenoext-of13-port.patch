+
+void Foam::matrixDB::compact()
+{
+    std::multimap<keyType, DynamicMatrix> newDB;
+    std::map<const DynamicMatrix*, iterType> remap;
+
+    forAll(LSmatrix_, celli)
+    {
+        forAll(LSmatrix_[celli], stencilI)
+        {
+            MatrixPtr& p = LSmatrix_[celli][stencilI];
+            if (!p.valid()) continue;
+
+            const DynamicMatrix* key = &(p.iterator()->second);
+            auto found = remap.find(key);
+            if (found == remap.end())
+            {
+                iterType nit =
+                    newDB.insert(newDB.end(), *(p.iterator()));
+                remap.emplace(key, nit);
+                p.set(nit);
+            }
+            else
+            {
+                p.set(found->second);
+            }
+        }
+    }
+
+    // node-based swap: the new iterators stay valid and now belong to DB_
+    DB_.swap(newDB);
+}

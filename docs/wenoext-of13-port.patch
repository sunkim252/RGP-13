+
+void Foam::WENOBase::buildStencilFlat()
+{
+    // CSR form of stencilsID_/cellToProcMap_ for the runtime kernel.
+    const label nCells = stencilsID_.size();
+    cellStart_.setSize(nCells + 1);
+
+    label nStencilTot = 0, nEntryTot = 0;
+    forAll(stencilsID_, celli)
+    {
+        cellStart_[celli] = nStencilTot;
+        nStencilTot += stencilsID_[celli].size();
+        forAll(stencilsID_[celli], si)
+        {
+            nEntryTot += stencilsID_[celli][si].size();
+        }
+    }
+    cellStart_[nCells] = nStencilTot;
+
+    stencilStart_.setSize(nStencilTot + 1);
+    stencilFlat_.setSize(nEntryTot);
+    procFlat_.setSize(nEntryTot);
+
+    label s = 0, e = 0;
+    forAll(stencilsID_, celli)
+    {
+        forAll(stencilsID_[celli], si)
+        {
+            stencilStart_[s++] = e;
+            const labelList& ids = stencilsID_[celli][si];
+            const labelList& pm = cellToProcMap_[celli][si];
+            forAll(ids, k)
+            {
+                stencilFlat_[e] = ids[k];
+                procFlat_[e] = short(k < pm.size() ? pm[k] : int(Cell::deleted));
+                e++;
+            }
+        }
+    }
+    stencilStart_[nStencilTot] = e;
+}
+
+
+void Foam::WENOBase::buildIntBasFlat(const fvMesh& localMesh)
+{
+    // Compact intBasTrans_ into the flat float array the runtime kernel
+    // reads (see intBasFlat_ in the header).  The compaction order must
+    // match sumFlux's (n,m,l) walk, which uses the dimList of the CELL
+    // on that side of the face, so build each side from its own cell.
+    const label nF = localMesh.nFaces();
+    intBasFlat_.setSize(2*nF*nDvt_, 0.0f);
+
+    const labelUList& own = localMesh.faceOwner();
+    const labelUList& nei = localMesh.faceNeighbour();
+
+    for (label facei = 0; facei < nF; facei++)
+    {
+        for (label side = 0; side < 2; side++)
+        {
+            const bool internal = (facei < localMesh.nInternalFaces());
+            if (side == 1 && !internal) continue;
+
+            const label celli = (side == 0) ? own[facei] : nei[facei];
+            const labelList& dim = dimList_[celli];
+            const volIntegralType& I = intBasTrans_[facei][side];
+
+            label k = 0;
+            float* dst = intBasFlat_.data() + (2*facei + side)*nDvt_;
+            for (label n = 0; n <= dim[0]; n++)
+            {
+                for (label m = 0; m <= dim[1]; m++)
+                {
+                    for (label l = 0; l <= dim[2]; l++)
+                    {
+                        if ((n + m + l) <= polOrder_ && (n + m + l) > 0)
+                        {
+                            if (k < nDvt_) dst[k] = float(I(n, m, l));
+                            k++;
+                        }
+                    }
+                }
+            }
+        }
+    }
+}

+    // peqsiFluid and its semantics are out of scope for the port.
+    Type flux = pTraits<Type>::zero;
+    for (label k = 0; k < nDvt; k++)
+    {
+        flux += coeffcI[k]*basis[k];
+    }
+    return flux;
